              "uniqueItems": true
            },
            "access_before_reception_during_activity": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "prior_existence",
            "contextual_availability",
            "linguistic_access",
            "access_before_reception_during_activity"
          ],
          "additionalProperties": false
        },
        "evidence_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_line"
          }
        },
        "independence_rationale": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "access_time_description": {
          "type": "string"
        },
        "justification": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependence": {
          "$ref": "#/$defs/dependence"
        },
        "access_basis": {
          "$ref": "#/$defs/access_basis"
        }
      },
      "required": [
        "id",
        "from_stage_id",
        "to_stage_id",
        "source_form_id",
        "recipient_attribution_id",
        "scenario_id",
        "status",
        "checks",
        "check_evidence",
        "evidence_lines",
        "independence_rationale",
        "route",
        "scope",
        "access_time_description",
        "justification",
        "limitations",
        "dependence",
        "access_basis"
