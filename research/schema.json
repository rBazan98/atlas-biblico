                "uncertain",
                "incompatible",
                "not_evaluated"
              ]
            },
            "contextual_availability": {
              "enum": [
                "supported",
                "uncertain",
                "incompatible",
                "not_evaluated"
              ]
            },
            "linguistic_access": {
              "enum": [
                "supported",
                "uncertain",
                "incompatible",
                "not_evaluated"
              ]
            },
            "access_before_reception_during_activity": {
