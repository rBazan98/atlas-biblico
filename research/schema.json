          "uniqueItems": true
        },
        "selected_date_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "selected_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "active_stage_ids",
        "selected_attribution_ids",
        "selected_date_ids",
        "selected_claim_ids",
        "notes"
      ],
      "additionalProperties": false
    },
    "evidence_line": {
      "type": "object",
