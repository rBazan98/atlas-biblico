        "basis_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "contribution": {
          "type": "string"
        }
      },
      "required": [
        "basis_id",
        "evidence_ids",
        "contribution"
      ],
      "additionalProperties": false
    },
    "dependence": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "proposed",
            "supported",
            "translation_attested",
            "not_supported"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
